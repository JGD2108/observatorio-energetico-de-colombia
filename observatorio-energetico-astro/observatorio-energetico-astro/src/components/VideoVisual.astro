---
interface Props {
  kind: 'sources' | 'lakehouse' | 'ingestion' | 'quality' | 'serving' | 'dashboard' | 'workflow' | 'review' | 'roadmap';
}

const { kind } = Astro.props;
const asset = (name: string) => `/presentation/${name}`;
---

<div class={`video-visual video-visual--${kind}`} aria-label={`Evidencia real para ${kind}`}>
  {kind === 'sources' && (
    <>
      <div class="video-visual__label">SECUENCIA REAL · PORTADA → DASHBOARD → REPOSITORIO</div>
      <div class="evidence-intro">
        <figure class="evidence-shot evidence-shot--wide"><img src={asset('powerbi-resumen.png')} alt="Resumen publicado del sistema eléctrico" /><figcaption>01 · Dashboard publicado</figcaption></figure>
        <div class="repo-tree"><span>02 · REPOSITORIO</span><b>observatorio-energetico-de-colombia/</b><code>├─ Ingestion/<br />├─ Silver/<br />├─ Gold/<br />├─ Serving/<br />├─ Automation/<br />└─ powerbi/</code></div>
      </div>
    </>
  )}

  {kind === 'lakehouse' && (
    <>
      <div class="video-visual__label">ARQUITECTURA MEDALLION · DECISIONES DE EXTREMO A EXTREMO</div>
      <figure class="evidence-shot evidence-shot--architecture"><img src={asset('medallion-architecture-v2.png')} alt="Arquitectura Medallion del Observatorio Energético de Colombia" /></figure>
    </>
  )}

  {kind === 'ingestion' && (
    <>
      <div class="video-visual__label">EVIDENCIA REAL · PARÁMETROS Y EJECUCIÓN</div>
      <figure class="evidence-shot evidence-shot--job evidence-shot--dim"><img src={asset('databricks-job-success.png')} alt="Flujo real del Job de Databricks" /></figure>
      <div class="parameter-overlay"><span>execution_mode</span><b>INCREMENTAL</b><span>backfill_start_date</span><b>2026-01-01</b><span>backfill_end_date</span><b>2026-12-31</b><span>backfill_chunk_days</span><b>31</b></div>
      <div class="video-visual__footer"><b>MERGE idempotente</b><i></i><b>backfill_id</b><i></i><b>cobertura validada</b></div>
    </>
  )}

  {kind === 'quality' && (
    <>
      <div class="video-visual__label">RESULTADO REAL · GOLD INCREMENTAL</div>
      <div class="quality-evidence">
        <div class="quality-evidence__score"><strong>62</strong><span>validaciones</span></div>
        <div class="quality-evidence__terminal"><p>Run ID: 263853691318294</p><p>Ventana: 2026-06-22 → 2026-08-05</p><p>Validaciones fallidas: <b>0</b></p><p>Bloqueantes fallidas: <b>0</b></p><strong>CONTROL DE CALIDAD APROBADO ✓</strong></div>
      </div>
      <div class="video-visual__footer"><b>esquema</b><i></i><b>grano</b><i></i><b>frescura</b><i></i><b>relaciones</b></div>
    </>
  )}

  {kind === 'serving' && (
    <>
      <div class="video-visual__label">EVIDENCIA REAL · CATÁLOGO ANALÍTICO</div>
      <figure class="evidence-shot evidence-shot--catalog"><img src={asset('databricks-catalog.png')} alt="Catálogo analítico publicado en Databricks" /><span class="privacy-mask">OWNER OCULTO</span><figcaption>Vistas consumidas por el modelo semántico</figcaption></figure>
    </>
  )}

  {kind === 'dashboard' && (
    <>
      <div class="video-visual__label">RECORRIDO REAL · CINCO PÁGINAS DE POWER BI</div>
      <div class="dashboard-filmstrip">
        <figure><img src={asset('powerbi-resumen.png')} alt="Página resumen del sistema" /><figcaption>01 · Resumen</figcaption></figure>
        <figure><img src={asset('powerbi-plantas.png')} alt="Página análisis por planta" /><figcaption>02 · Plantas</figcaption></figure>
        <figure><img src={asset('powerbi-operacion.png')} alt="Página operación técnica" /><figcaption>03 · Operación</figcaption></figure>
        <figure><img src={asset('powerbi-demanda.png')} alt="Página demanda y mercado" /><figcaption>04 · Mercado</figcaption></figure>
        <figure><img src={asset('powerbi-embalses.png')} alt="Página embalses y cobertura" /><figcaption>05 · Embalses</figcaption></figure>
      </div>
    </>
  )}

  {kind === 'workflow' && (
    <>
      <div class="video-visual__label">ORQUESTACIÓN REAL · DEPENDENCIAS, PARALELISMO Y PUBLICACIÓN</div>
      <div class="workflow-evidence">
        <figure class="evidence-shot evidence-shot--workflow"><img src={asset('databricks-job-success.png')} alt="Workflow completo del Observatorio en Databricks" /></figure>
        <div class="workflow-evidence__steps">
          <div><span>01 · PREPARAR</span><b>Catálogo y auditoría</b><small>setup_catalog · audit_start</small></div>
          <div><span>02 · PARALELO</span><b>9 ingestas independientes</b><small>fuentes sincronizadas</small></div>
          <div><span>03 · BARRERAS</span><b>Bronze → Silver → Gold</b><small>ninguna capa consume incompleta</small></div>
          <div><span>04 · PUBLICAR</span><b>Calidad → Serving → cierre</b><small>Fase 9 valida la operación final</small></div>
        </div>
      </div>
      <div class="video-visual__footer"><b>grafo de dependencias</b><i></i><b>tareas paralelas</b><i></i><b>barreras de capa</b><i></i><b>APTO al cierre</b></div>
    </>
  )}

  {kind === 'review' && (
    <>
      <div class="video-visual__label">EVIDENCIA REAL · NOTEBOOK 96_MANUAL_PHASE9_REVIEW</div>
      <div class="review-evidence">
        <pre><code>review = assess(
  stale_sources=0,
  latest_pipeline_status="SUCCESS",
  open_blocking_quality_alerts=0,
  serving_views_ready=9
)</code></pre>
        <div><small>SALIDA</small><strong>REVISION FASE 9: APTO</strong><p>Sin hallazgos operativos.</p><span>solo lectura · sin escrituras · sin alertas automáticas</span></div>
      </div>
    </>
  )}

  {kind === 'roadmap' && (
    <>
      <div class="video-visual__label">README · PRÓXIMA EVOLUCIÓN</div>
      <div class="roadmap-steps"><div><span>HOY</span><b>Generación<br />Mercado<br />Embalses</b></div><i>→</i><div><span>FASE 10</span><b>Tarifas<br />Red<br />Calidad</b></div><i>→</i><div><span>CONTRATO CERTIFICADO</span><b>Hidrología<br />Pronóstico</b></div></div>
      <div class="video-visual__footer"><b>fuente oficial</b><i></i><b>calidad</b><i></i><b>reconciliación</b><i></i><b>Serving</b></div>
    </>
  )}
</div>
