	partition DimFecha = calculated
		mode: import
		source =
				
				VAR FechasDisponibles =
				    UNION(
				        SELECTCOLUMNS('vw_resumen_diario_sistema', "Fecha", 'vw_resumen_diario_sistema'[fecha]),
				        SELECTCOLUMNS('vw_operacion_diaria_planta', "Fecha", 'vw_operacion_diaria_planta'[fecha]),
				        SELECTCOLUMNS('vw_generacion_diaria_tipo', "Fecha", 'vw_generacion_diaria_tipo'[fecha]),
				        SELECTCOLUMNS('demanda_mercado_diaria', "Fecha", 'demanda_mercado_diaria'[fecha]),
				        SELECTCOLUMNS('energia_embalsada_diaria', "Fecha", 'energia_embalsada_diaria'[fecha])
				    )
				RETURN
				ADDCOLUMNS(
				    CALENDAR(MINX(FechasDisponibles, [Fecha]), MAXX(FechasDisponibles, [Fecha])),
				    "Año", YEAR([Date]),
				    "MesNumero", MONTH([Date]),
				    "Mes", FORMAT([Date], "MMMM"),
				    "AñoMes", FORMAT([Date], "yyyy-MM"),
				    "Trimestre", "T" & FORMAT([Date], "Q"),
				    "DiaSemana", FORMAT([Date], "dddd")
				)

	annotation PBI_Id = b05dd63b2c964d2a89559764068a6eb0

